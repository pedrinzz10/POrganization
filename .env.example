# Copie para .env (ignorado pelo git) e preencha: cp .env.example .env
# Variáveis com PASSWORD, SECRET, TOKEN, PRIVATE ou _KEY no nome ficam vazias aqui (checado pelo CI).

# Banco (Supabase > Connect > Session pooler). Use o session pooler (porta 5432):
# a conexão direta é só IPv6 e o modo transaction (6543) quebra o JDBC e o Flyway.
DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<ref-do-projeto>
DB_PASSWORD=
