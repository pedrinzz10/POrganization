# Copie para .env (ignorado pelo git) e preencha: cp .env.example .env
# Variáveis com PASSWORD, SECRET, TOKEN, PRIVATE ou _KEY no nome ficam vazias aqui (checado pelo CI).

# Banco (Supabase > Connect > Session pooler). Use o session pooler (porta 5432):
# a conexão direta é só IPv6 e o modo transaction (6543) quebra o JDBC e o Flyway.
DB_URL=jdbc:postgresql://aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<ref-do-projeto>
DB_PASSWORD=

# Supabase Auth (Project Settings > JWT Keys). Ative as JWT Signing Keys assimétricas (ES256):
# com a chave legada HS256 o JWKS não publica chaves e a API recusa todos os tokens.
SUPABASE_JWKS_URI=https://<ref-do-projeto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER=https://<ref-do-projeto>.supabase.co/auth/v1

# Origem do frontend liberada no CORS (várias separadas por vírgula)
FRONTEND_ORIGIN=http://localhost:4200

# Segredo do header X-Cron-Secret dos endpoints /internal/** (cron externo dos lembretes).
# Gere com: openssl rand -hex 32
CRON_SECRET=

# Endereço do app (links dos e-mails e das notificações)
APP_URL=http://localhost:4200

# SMTP dos lembretes por e-mail (vazio = e-mail desligado). Ex.: Gmail com senha de app, Brevo.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Web Push (lembretes no navegador). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@exemplo.com

# Google Calendar (OAuth). Client do tipo "Aplicativo da Web" no Google Cloud, com a Calendar API ativada.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/integrations/google/callback
# Chave AES-256 dos tokens no banco. Gere com: openssl rand -base64 32
GOOGLE_TOKEN_KEY=
